# Copy to web/.env.local. Do not commit.
DATABASE_URL=                    # postgresql://user:pass@host:5432/db
NEXT_PUBLIC_BOT_USERNAME=        # download deep links, without @
BOT_TOKEN=                       # Bot Drop and thumbnail actions
STORAGE_CHANNEL_ID=              # private storage channel id
OWNER_USER_ID=                   # owner chat id used by Bot Drop/thumbnail actions
APP_PASSWORD=                    # shared dashboard password; empty disables web auth
PIN=                             # numeric PIN for Private space; empty disables it
STREAMER_URL=http://127.0.0.1:8080 # streamer URL when running streamer.py locally
STREAMER_SECRET=                 # optional shared secret for the streamer
